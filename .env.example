APP_ENV=local
APP_DEBUG=false
APP_NAME=NeNe Profile
NENE2_MACHINE_API_KEY=
NENE2_LOCAL_JWT_SECRET=
PROBLEM_DETAILS_BASE_URL=https://nene-profile.dev/problems/

# Tenant resolution: single (default) | path | subdomain
TENANT_RESOLUTION=single
ORG_SLUG=default
BASE_DOMAIN=localhost

# Database (default: SQLite for local/test; MySQL for Docker)
DATABASE_URL=
DB_ENV=local
DB_ADAPTER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=var/nene_profile.sqlite
DB_USER=nene_profile
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Docker Compose overrides (copy to .env and uncomment)
# DB_ADAPTER=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=nene_profile
# DB_USER=nene_profile
# DB_PASSWORD=nene_profile
# MYSQL_ROOT_PASSWORD=nene_profile_root
#
# ── Local ports (fixed; do not change without updating port registry) ─────────
# NeNe Profile is assigned 84** / 3409 in the local port registry.
# See .cursor/rules/00-project-always.mdc for the full registry.
NENE_PROFILE_PORT=8490
NENE_PROFILE_MYSQL_PORT=3409
NENE_PROFILE_PHPMYADMIN_PORT=8491
